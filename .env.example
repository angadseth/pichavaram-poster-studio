# Copy to .env.local for local dev. Everything works locally with no values set:
# the DB is a SQLite file in data/, and emails (incl. OTP codes) are written to .outbox/.

# Turso (free): turso db create poster-studio && turso db show --url / turso db tokens create
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Comma-separated emails that are always admins (they add the RCs from /admin).
ADMIN_EMAILS=

# Gmail SMTP with an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pichavaram Poster Studio <you@gmail.com>"

# Public URL used in poster emails (e.g. https://pichavaram-posters.vercel.app)
APP_URL=
